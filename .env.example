# --- LLM: OpenCode Go (OpenAI-compatible chat completions). Used by analyze, plan, build and the web chatbot.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
SRG_MODEL=glm-5.3
SRG_OUTPUT_MODE=tool          # tool | native | prompted (fallback for weak tool-calling models)
SRG_LLM_CONCURRENCY=4
SRG_LLM_RETRIES=3

# --- Gel (docker compose)
GEL_DSN=gel://admin@localhost:5656/main
GEL_TLS_SECURITY=insecure

# --- MinIO (docker compose)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=spec-run-telemetry

# --- System under test
SUT_BASE_URL=http://localhost:8000
SUT_HEALTH_PATH=/

# --- Paths / tools
TEST_GENERATED_DIR=./test_generated   # engine output: $TEST_GENERATED_DIR/<engine>/
REPORTS_DIR=./reports
BRU_BIN=bru

# --- Secrets referenced by tests as {{ $env.X }}; passed to bru as process env, never written to files
CUSTOMER_TOKEN=customer-token
ADMIN_TOKEN=admin-token
